{
  "name": "india-ids",
  "version": 1,
  "description": "Indian national and financial identity formats (PAN, Aadhaar, IFSC, UPI)",
  "customRules": [
    {
      "id": "pan",
      "label": "PAN Card",
      "token": "PAN",
      "patternString": "\\b[A-Z]{5}\\d{4}[A-Z]\\b",
      "isRegex": true,
      "enabled": true
    },
    {
      "id": "aadhaar",
      "label": "Aadhaar Number",
      "token": "AADHAAR",
      "patternString": "(?<![\\w-])(?:\\d{4}[ -]?){2}\\d{4}(?![\\w-])",
      "isRegex": true,
      "enabled": true
    },
    {
      "id": "ifsc",
      "label": "IFSC Code",
      "token": "IFSC",
      "patternString": "\\b[A-Z]{4}0[A-Z0-9]{6}\\b",
      "isRegex": true,
      "enabled": true
    },
    {
      "id": "upi",
      "label": "UPI VPA ID",
      "token": "UPI",
      "patternString": "\\b[a-zA-Z0-9_.-]+@[a-zA-Z]{3,}(?!(?:\\.[a-zA-Z]{2,}))\\b",
      "isRegex": true,
      "enabled": true
    }
  ]
}
